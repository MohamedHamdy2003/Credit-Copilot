# Local only. Copy to .env; never commit credentials.
DATABASE_URL=postgresql://copilot:copilot_local@localhost:54329/credit_copilot
# Optional dedicated live evaluation DB; otherwise DATABASE_URL's name gains _eval.
# EVALUATION_DATABASE_URL=postgresql://copilot:copilot_local@localhost:54329/credit_copilot_eval
# EVALUATION_GENERATION_INTERVAL_MS=0
# Increase spacing for lower embedding request quotas.
# SEED_EMBEDDING_INTERVAL_MS=750
PORT=3000
WEB_ORIGIN=http://localhost:5173
ASSESSMENT_MODE=strict
ASSESSMENT_ORCHESTRATION=workflow
ALLOW_DEMO_MODE=false
LLM_PROVIDER=gemini
OLLAMA_FALLBACK_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_TIMEOUT_MS=120000
GEMINI_API_KEY=
# Set confirmed_free only after checking that the API key's project is on Gemini Free Tier.
GEMINI_BILLING_TIER=unknown
GENERATION_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
RETRIEVAL_STRATEGY=hybrid
RETRIEVAL_MIN_SIMILARITY=0.65
QUERY_REWRITE_MAX_EXPANSIONS=2
UPLOAD_MAX_BYTES=10485760
# Set a unique >=12-character password before seeding demo accounts.
DEMO_PASSWORD=
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
# Optional test/proxy/Compose overrides; keep test DB isolated and run suites sequentially.
# TEST_DATABASE_URL=postgresql://copilot:copilot_local@localhost:54329/credit_copilot_test
# API_PROXY_TARGET=http://127.0.0.1:3000
# POSTGRES_PASSWORD=copilot_local
# Match DATABASE_URL to the published Compose port if you override it.
# POSTGRES_PORT=54329
# COMPOSE_PROJECT_NAME=credit-copilot-review
