# Local only. Copy to .env; never commit credentials.
DATABASE_URL=postgresql://copilot:copilot_local@localhost:54329/credit_copilot
# Optional dedicated live evaluation DB; otherwise DATABASE_URL's name gains _eval.
# EVALUATION_DATABASE_URL=postgresql://copilot:copilot_local@localhost:54329/credit_copilot_eval
PORT=3000
WEB_ORIGIN=http://localhost:5173
ASSESSMENT_MODE=strict
ALLOW_DEMO_MODE=false
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GENERATION_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
RETRIEVAL_MIN_SIMILARITY=0.65
UPLOAD_MAX_BYTES=10485760
# Set a unique >=12-character password before seeding demo accounts.
DEMO_PASSWORD=
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
# Optional test/proxy/Compose overrides; keep test DB isolated and run suites sequentially.
# TEST_DATABASE_URL=postgresql://copilot:copilot_local@localhost:54329/credit_copilot_test
# API_PROXY_TARGET=http://127.0.0.1:3000
# POSTGRES_PASSWORD=copilot_local
