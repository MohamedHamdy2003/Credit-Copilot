{
  "name": "credit-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build": "pnpm build:api && pnpm build:web",
    "start": "node dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --config jest.integration.config.cjs",
    "lint": "eslint \"{apps,packages,scripts,tests}/**/*.{ts,tsx}\"",
    "format": "prettier --write apps packages scripts tests *.json *.yaml .github",
    "format:check": "prettier --check apps packages scripts tests *.json *.yaml .github",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "ask": "tsx scripts/ask.ts",
    "calculate": "tsx scripts/calculate.ts"
  },
  "dependencies": {
    "@mastra/core": "1.83.0",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "12.1.2",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.10",
    "helmet": "8.3.0",
    "js-tiktoken": "1.0.21",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "remark-parse": "11.0.0",
    "rxjs": "7.8.2",
    "typeorm": "1.1.3",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  }
}
